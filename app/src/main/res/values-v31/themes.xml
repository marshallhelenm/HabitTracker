<resources>
    <!-- Android 12+ launch screen. Must repeat the base theme's items, since this file replaces it on API 31+. -->
    <style name="Theme.HabitTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <!-- 288dp canvas; the pig is sized to stay inside the 192dp circle the system shows. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_pig</item>
    </style>
</resources>
